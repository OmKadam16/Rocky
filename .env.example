# Copy to .env.local and fill in. Never commit .env.local.
#
# Supabase: Dashboard -> Project Settings -> API Keys.
# The publishable / anon key is meant to be public; every table is protected by RLS.
# Leave these empty to run Rocky fully on-device (no account, no phone sync).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# NEVER put the service-role / secret key in any VITE_ variable: Vite ships VITE_ values to the browser.

# Optional: override the site URL encoded in the phone-pairing QR code.
# Leave empty to use the page's own origin (correct on Render).
# VITE_PUBLIC_URL=https://rocky.onrender.com
