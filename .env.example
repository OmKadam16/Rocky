# Copy to .env.local and fill in. Never commit .env.local.
#
# Supabase: Dashboard -> Project Settings -> API Keys.
# The publishable / anon key is meant to be public; every table is protected by RLS.
# Leave these empty to run Rocky fully on-device (no account, no phone sync).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# NEVER put the service-role / secret key in any VITE_ variable: Vite ships VITE_ values to the browser.

# The Rocky website the PHONE opens to pair (Profile -> Devices shows it:
# "On your phone, open <this> and enter this code"). Needed for the desktop
# app, whose own origin (app://rocky) a phone can't open. Use the https site
# (the phone mic needs https), e.g. the Render static site. build:win and
# build:mac warn loudly when it is unset (set ROCKY_REQUIRE_PUBLIC_URL=1 to
# make that an error) and stop on a non-http(s) value. Without it, paste the
# address in Devices -> "Phone site address" (saved on your profile).
# VITE_PUBLIC_URL=https://rocky.onrender.com
