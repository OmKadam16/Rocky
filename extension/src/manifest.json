{
  "manifest_version": 3,
  "name": "Rocky Memory",
  "version": "0.1.0",
  "description": "Saves pages you read to Rocky's Memory on this computer. Nothing leaves your laptop.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rocky Memory",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "116"
}
