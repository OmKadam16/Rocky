{
  "name": "rocky-calendar",
  "productName": "Rocky",
  "private": true,
  "version": "0.1.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build:electron && electron .",
    "build:mac": "npm run build:electron && electron-builder --mac",
    "install:app": "npm run build:mac && scripts/install-local.sh",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:agent-e2e": "electron electron/test/agentE2E.cjs",
    "test:agent-android": "node scripts/agent-android-e2e.mjs",
    "build:win": "npm run build:electron && electron-builder --win --publish never",
    "build:extension": "node scripts/build-extension.mjs",
    "screens:phone": "node scripts/phone-screens.mjs",
    "build:android": "node scripts/build-android.mjs debug",
    "build:android:release": "node scripts/build-android.mjs release",
    "build:android:web": "node scripts/build-android.mjs web",
    "test:extract-e2e": "electron electron/test/extractE2E.cjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-updater": "^8.52.1",
    "@supabase/supabase-js": "^2.117.3",
    "dexie": "^4.4.5",
    "electron-updater": "^6.8.9",
    "motion": "^14.1.0",
    "openai": "^7.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.128.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-builder": "^2.0.29",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  },
  "main": "electron/main.cjs",
  "rocky": {
    "androidMinNative": "0.1.14"
  },
  "description": "Voice-driven personal calendar",
  "build": {
    "appId": "com.rocky.calendar",
    "productName": "Rocky",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/agentCore.mjs",
      "shared/agentPageScripts.mjs",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Rocky listens when you tap the mic so you can talk to your calendar."
      },
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Rocky"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OmKadam16",
        "repo": "rocky-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rocky"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
